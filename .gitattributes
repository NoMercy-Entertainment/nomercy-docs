# Auto-detect and normalize
* text=auto eol=lf

# Source code
*.astro         text
*.tsx           text
*.ts            text
*.js            text
*.mjs           text
*.css           text diff=css
*.html          text diff=html

# Documentation
*.md            text diff=markdown
*.mdx           text diff=markdown

# Config / data
*.json          text
*.yml           text
*.yaml          text
*.lock          text -diff
*.gitignore     text

# Shell scripts (force LF)
*.sh            text eol=lf

# Binary: images
*.png           binary
*.jpg           binary
*.webp          binary
*.svg           text

# Linguist
*.astro         linguist-language=Astro
*.mdx           linguist-language=MDX
