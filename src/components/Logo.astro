---
export interface Props {
  className?: string
}

const { className } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <circle cx="12" cy="12" r="10" fill="rgb(34 197 94)" />
  <text
    x="12"
    y="16"
    font-size="10"
    font-weight="bold"
    fill="white"
    text-anchor="middle"
  >
    NM
  </text>
</svg>
