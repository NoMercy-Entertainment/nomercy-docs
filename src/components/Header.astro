---
import clsx from 'clsx'
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.jsx'
import MobileNavigation from './MobileNavigation.jsx'

---

<div class="fixed top-0 z-50 flex w-full items-center border-b border-zinc-900/10 bg-white/75 py-3 backdrop-blur sm:px-6 lg:left-72 lg:z-30 lg:border-l lg:border-zinc-900/10 xl:left-80 dark:border-white/10 dark:bg-zinc-900/75">
  <div class="mr-auto flex w-full items-center gap-4 lg:hidden">
    <MobileNavigation client:load />
    <a href="/" aria-label="Home">
      <Logo className="h-6" />
    </a>
  </div>
  <div class="ml-auto flex items-center gap-3 sm:gap-4 lg:ml-0">
    <ThemeToggle client:load />
  </div>
</div>

<style>
  :global(.dark) {
    color-scheme: dark;
  }
</style>

