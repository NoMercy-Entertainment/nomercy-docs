---
// Sticky dropdown that rewrites every visible `npm install` / `npm i`
// command on the current page to yarn / pnpm / bun. Pure DOM rewriter —
// no MDX component changes needed; works on every code block already
// rendered.
//
// Race-proof approach: tag each pre with a stable id and snapshot the
// raw command BEFORE CodeHighlighter (React useEffect) runs. After
// CodeHighlighter wraps/clones the pre, the id survives, so the swap
// can always re-find the original text via the snapshot map.
//
// Preference persists in localStorage so the user's choice survives
// navigation and reload.
---

<div class="package-manager-switcher" data-pm-switcher>
  <label class="pm-label" for="pm-select">Package manager</label>
  <select id="pm-select" class="pm-select" aria-label="Package manager">
    <option value="npm">npm</option>
    <option value="yarn">yarn</option>
    <option value="pnpm">pnpm</option>
    <option value="bun">bun</option>
  </select>
</div>

<style>
  .package-manager-switcher {
    position: sticky;
    top: 72px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    margin-bottom: 16px;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(228 228 231 / 1);
    border-radius: 8px;
    z-index: 20;
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
  }
  :global(.dark) .package-manager-switcher {
    background: rgb(39 39 42 / 0.9);
    border-color: rgb(63 63 70 / 1);
  }
  .pm-label {
    color: rgb(82 82 91);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  :global(.dark) .pm-label {
    color: rgb(161 161 170);
  }
  .pm-select {
    appearance: none;
    background: transparent;
    border: 1px solid rgb(228 228 231);
    border-radius: 6px;
    padding: 2px 24px 2px 8px;
    font-family: 'Cascadia Code', 'Fira Code', ui-monospace, monospace;
    color: inherit;
    cursor: pointer;
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: right 9px top 50%, right 5px top 50%;
    background-size: 4px 4px, 4px 4px;
    background-repeat: no-repeat;
  }
  :global(.dark) .pm-select {
    border-color: rgb(63 63 70);
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'docs-pm';
    var snapshots = new Map(); // pmId -> originalText
    var nextId = 0;
    var currentTarget = 'npm';
    try { currentTarget = localStorage.getItem(STORAGE_KEY) || 'npm'; } catch (_) {}

    function translate(text, target) {
      if (target === 'npm') return text;
      var out = text;
      out = out.replace(/\bnpm\s+(install|i)\b((?:\s+--?[A-Za-z-]+)*)/g, function (m, _verb, flags) {
        var f = flags || '';
        if (target === 'yarn') {
          var fy = f.replace(/-D/g, '--dev').replace(/--save-dev/g, '--dev');
          return 'yarn add' + fy;
        }
        if (target === 'pnpm') return 'pnpm add' + f;
        if (target === 'bun')  return 'bun add' + f;
        return m;
      });
      out = out.replace(/\bnpm\s+install\b(?!\s+\S)/g,
        target === 'yarn' ? 'yarn install' :
        target === 'pnpm' ? 'pnpm install' :
        target === 'bun'  ? 'bun install' : 'npm install');
      out = out.replace(/\bnpm\s+run\s+/g,
        target === 'yarn' ? 'yarn ' :
        target === 'pnpm' ? 'pnpm ' :
        target === 'bun'  ? 'bun run ' : 'npm run ');
      out = out.replace(/\bnpx\s+/g,
        target === 'yarn' ? 'yarn dlx ' :
        target === 'pnpm' ? 'pnpm dlx ' :
        target === 'bun'  ? 'bunx ' : 'npx ');
      return out;
    }

    // Pull the raw source from whichever attribute the renderer left it on.
    // Astro's MDX writes `code=`; shiki writes `data-highlighted=` (HTML-encoded);
    // CodePanel writes the highlighted HTML directly into the code child.
    function extractOriginal(pre) {
      var raw = pre.getAttribute('code');
      if (raw) return raw;
      var dh = pre.getAttribute('data-highlighted');
      if (dh) {
        var div = document.createElement('div');
        div.innerHTML = dh;
        return div.textContent || '';
      }
      return pre.textContent || '';
    }

    // Snapshot every untagged pre on the page. Run as early as possible
    // (parse time inline) AND on every mutation so cloned pres get tagged.
    function snapshotAll() {
      var pres = document.querySelectorAll('pre:not([data-pm-id])');
      for (var i = 0; i < pres.length; i++) {
        var pre = pres[i];
        var raw = extractOriginal(pre);
        if (!/\b(npm|npx)\b/.test(raw)) {
          pre.setAttribute('data-pm-id', 'skip');
          continue;
        }
        var id = String(++nextId);
        pre.setAttribute('data-pm-id', id);
        snapshots.set(id, raw);
      }
      // Tag clones (CodeHighlighter clones the pre into a wrapper after
      // initial highlight). The clone inherits the id but the original
      // is detached. Re-tagging clones is idempotent.
      var tagged = document.querySelectorAll('pre[data-pm-id]:not([data-pm-id="skip"])');
      for (var j = 0; j < tagged.length; j++) {
        var cl = tagged[j];
        if (!snapshots.has(cl.getAttribute('data-pm-id'))) {
          // Orphan id (clone of a now-detached pre). Re-extract.
          var rawCl = extractOriginal(cl);
          if (/\b(npm|npx)\b/.test(rawCl)) {
            var newId = String(++nextId);
            cl.setAttribute('data-pm-id', newId);
            snapshots.set(newId, rawCl);
          }
        }
      }
    }

    function applyToPre(pre, target) {
      var id = pre.getAttribute('data-pm-id');
      if (!id || id === 'skip') return;
      var original = snapshots.get(id);
      if (!original) return;
      var next = translate(original, target);
      var code = pre.querySelector('code');
      var targetEl = code || pre;
      if (targetEl.textContent !== next) {
        targetEl.textContent = next;
      }
    }

    function applyAll(target) {
      currentTarget = target;
      snapshotAll();
      var pres = document.querySelectorAll('pre[data-pm-id]:not([data-pm-id="skip"])');
      for (var i = 0; i < pres.length; i++) applyToPre(pres[i], target);
    }

    // Re-apply on any DOM mutation, with rAF coalescing so the loop
    // doesn't fight CodeHighlighter on every single innerHTML write.
    var rafPending = false;
    function scheduleApply() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(function () {
        rafPending = false;
        applyAll(currentTarget);
      });
    }

    function syncSelect() {
      var select = document.getElementById('pm-select');
      if (select && select.value !== currentTarget) select.value = currentTarget;
    }

    function watch() {
      var obs = new MutationObserver(function (records) {
        // Cheap filter — only schedule when something interesting changed.
        for (var i = 0; i < records.length; i++) {
          var rec = records[i];
          if (rec.type === 'childList' && (rec.addedNodes.length || rec.removedNodes.length)) {
            syncSelect();
            scheduleApply();
            return;
          }
          if (rec.type === 'characterData') {
            scheduleApply();
            return;
          }
          if (rec.type === 'attributes' && rec.attributeName === 'data-highlighted') {
            scheduleApply();
            return;
          }
        }
      });
      obs.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
        attributeFilter: ['data-highlighted'],
      });
    }

    // Document-level delegation so the listener survives any React
    // hydration / re-render that tears down and rebuilds the select.
    document.addEventListener('change', function (e) {
      var t = e.target;
      if (!t || t.id !== 'pm-select') return;
      var target = t.value;
      try { localStorage.setItem(STORAGE_KEY, target); } catch (_) {}
      applyAll(target);
    });

    function init() {
      var select = document.getElementById('pm-select');
      if (!select) return;
      var saved;
      try { saved = localStorage.getItem(STORAGE_KEY) || 'npm'; } catch (_) { saved = 'npm'; }
      select.value = saved;
      currentTarget = saved;
      applyAll(saved);
      watch();
    }

    // Take snapshots as early as possible so we capture the raw `code`
    // attribute before CodeHighlighter strips it on mount.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        snapshotAll();
        init();
      });
    } else {
      snapshotAll();
      init();
    }
    document.addEventListener('astro:after-swap', function () {
      // SPA-style navigation: snapshots reset because DOM rebuilt.
      snapshots = new Map();
      nextId = 0;
      snapshotAll();
      init();
    });
  })();
</script>
