---
// Floating chip that rewrites every visible `npm install` / `npm i` /
// `npm run` / `npx` command on the current page to yarn / pnpm / bun.
// Pure DOM rewriter — works on every code block already rendered.
//
// Pinned top-right under the header so it doesn't crowd the article
// header. Hides automatically when the page has no npm/npx commands.
//
// Preference persists in localStorage so the user's choice survives
// navigation and reload.
---

<div class="package-manager-switcher" data-pm-switcher hidden role="group" aria-label="Package manager">
  <button type="button" class="pm-btn" data-pm-value="npm">npm</button>
  <button type="button" class="pm-btn" data-pm-value="yarn">yarn</button>
  <button type="button" class="pm-btn" data-pm-value="pnpm">pnpm</button>
  <button type="button" class="pm-btn" data-pm-value="bun">bun</button>
</div>

<style>
  .package-manager-switcher {
    position: fixed;
    top: 4rem;
    right: 1rem;
    z-index: 25;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    background: rgb(255 255 255 / 0.9);
    border: 1px solid rgb(228 228 231 / 1);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.08);
  }
  .package-manager-switcher[hidden] {
    display: none;
  }
  :global(.dark) .package-manager-switcher {
    background: rgb(24 24 27 / 0.9);
    border-color: rgb(63 63 70 / 1);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.4);
  }
  @media (max-width: 640px) {
    .package-manager-switcher {
      top: auto;
      bottom: 1rem;
      right: 1rem;
    }
  }
  .pm-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 3px 10px;
    border-radius: 999px;
    font-family: 'Cascadia Code', 'Fira Code', ui-monospace, monospace;
    font-size: inherit;
    color: rgb(82 82 91);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pm-btn:hover {
    color: rgb(24 24 27);
  }
  .pm-btn[aria-pressed='true'] {
    background: rgb(16 185 129);
    color: rgb(255 255 255);
  }
  :global(.dark) .pm-btn {
    color: rgb(161 161 170);
  }
  :global(.dark) .pm-btn:hover {
    color: rgb(244 244 245);
  }
  :global(.dark) .pm-btn[aria-pressed='true'] {
    background: rgb(16 185 129);
    color: rgb(255 255 255);
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'docs-pm';
    var snapshots = new Map(); // pmId -> originalText
    var nextId = 0;
    var currentTarget = 'npm';
    try { currentTarget = localStorage.getItem(STORAGE_KEY) || 'npm'; } catch (_) {}

    function translate(text, target) {
      if (target === 'npm') return text;
      var out = text;
      out = out.replace(/\bnpm\s+(install|i)\b((?:\s+--?[A-Za-z-]+)*)/g, function (m, _verb, flags) {
        var f = flags || '';
        if (target === 'yarn') {
          var fy = f.replace(/-D/g, '--dev').replace(/--save-dev/g, '--dev');
          return 'yarn add' + fy;
        }
        if (target === 'pnpm') return 'pnpm add' + f;
        if (target === 'bun')  return 'bun add' + f;
        return m;
      });
      out = out.replace(/\bnpm\s+install\b(?!\s+\S)/g,
        target === 'yarn' ? 'yarn install' :
        target === 'pnpm' ? 'pnpm install' :
        target === 'bun'  ? 'bun install' : 'npm install');
      out = out.replace(/\bnpm\s+run\s+/g,
        target === 'yarn' ? 'yarn ' :
        target === 'pnpm' ? 'pnpm ' :
        target === 'bun'  ? 'bun run ' : 'npm run ');
      out = out.replace(/\bnpx\s+/g,
        target === 'yarn' ? 'yarn dlx ' :
        target === 'pnpm' ? 'pnpm dlx ' :
        target === 'bun'  ? 'bunx ' : 'npx ');
      return out;
    }

    function extractOriginal(pre) {
      // data-code-raw is the canonical source text, kept current by the
      // VersionInjector. Prefer it so a version rewrite never leaves the
      // switcher comparing against a stale snapshot.
      var rawAttr = pre.getAttribute('data-code-raw');
      if (rawAttr) return rawAttr;
      var raw = pre.getAttribute('code');
      if (raw) return raw;
      var dh = pre.getAttribute('data-highlighted');
      if (dh) {
        var div = document.createElement('div');
        div.innerHTML = dh;
        return div.textContent || '';
      }
      return pre.textContent || '';
    }

    function snapshotAll() {
      var pres = document.querySelectorAll('pre:not([data-pm-id])');
      for (var i = 0; i < pres.length; i++) {
        var pre = pres[i];
        var raw = extractOriginal(pre);
        // Match real npm/npx COMMANDS only (whitespace-delimited). A bare
        // `\bnpm\b` also matched the "/npm/" path segment in jsdelivr CDN
        // URLs, so HTML `<script src=".../npm/...">` blocks got snapshotted
        // and clobbered to plain text. Require surrounding whitespace.
        if (!/(?:^|\s)(npm|npx)(?:\s|$)/.test(raw)) {
          pre.setAttribute('data-pm-id', 'skip');
          continue;
        }
        var id = String(++nextId);
        pre.setAttribute('data-pm-id', id);
        snapshots.set(id, raw);
      }
      syncVisibility();
    }

    function syncVisibility() {
      var widget = document.querySelector('[data-pm-switcher]');
      if (!widget) return;
      var hasAny = document.querySelector('pre[data-pm-id]:not([data-pm-id="skip"])');
      if (hasAny) widget.removeAttribute('hidden');
      else widget.setAttribute('hidden', '');
    }

    function applyToPre(pre, target) {
      var id = pre.getAttribute('data-pm-id');
      if (!id || id === 'skip') return;
      // Read the canonical source fresh so a version rewrite (VersionInjector
      // updates data-code-raw) can't make a stale snapshot clobber the block.
      var original = extractOriginal(pre) || snapshots.get(id);
      if (!original) return;
      var next = translate(original, target);
      var code = pre.querySelector('code');
      var targetEl = code || pre;
      // Only rewrite when the COMMAND actually changed. Comparing whitespace-
      // normalized text leaves the highlighted spans intact when nothing
      // changed (npm default), instead of flattening them to plain textContent.
      var norm = function (s) { return (s || '').replace(/\s+/g, ' ').trim(); };
      if (norm(targetEl.textContent) !== norm(next)) {
        targetEl.textContent = next;
      }
    }

    function applyAll(target) {
      currentTarget = target;
      snapshotAll();
      var pres = document.querySelectorAll('pre[data-pm-id]:not([data-pm-id="skip"])');
      for (var i = 0; i < pres.length; i++) applyToPre(pres[i], target);
    }

    function syncSelect() {
      var btns = document.querySelectorAll('[data-pm-switcher] .pm-btn');
      for (var i = 0; i < btns.length; i++) {
        var btn = btns[i];
        var on = btn.getAttribute('data-pm-value') === currentTarget;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    }

    var rafPending = false;
    function scheduleApply() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(function () {
        rafPending = false;
        applyAll(currentTarget);
      });
    }

    function watch() {
      var obs = new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
          var rec = records[i];
          if (rec.type === 'childList' && (rec.addedNodes.length || rec.removedNodes.length)) {
            syncSelect();
            scheduleApply();
            return;
          }
          if (rec.type === 'characterData') {
            scheduleApply();
            return;
          }
          if (rec.type === 'attributes' && rec.attributeName === 'data-highlighted') {
            scheduleApply();
            return;
          }
        }
      });
      obs.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
        attributeFilter: ['data-highlighted'],
      });
    }

    // Document-level delegation so the listener survives any hydration
    // / re-render that tears down and rebuilds the chip.
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest ? e.target.closest('[data-pm-value]') : null;
      if (!t) return;
      var target = t.getAttribute('data-pm-value');
      if (!target) return;
      try { localStorage.setItem(STORAGE_KEY, target); } catch (_) {}
      applyAll(target);
      syncSelect();
    });

    function init() {
      syncSelect();
      applyAll(currentTarget);
      watch();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        snapshotAll();
        init();
      });
    } else {
      snapshotAll();
      init();
    }
    document.addEventListener('astro:after-swap', function () {
      snapshots = new Map();
      nextId = 0;
      snapshotAll();
      init();
    });
  })();
</script>
