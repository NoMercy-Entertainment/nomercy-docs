---
import { getLocales } from '../lib/i18n';

const availableLocales: string[] = getLocales();
const currentLocale = Astro.currentLocale ?? 'en';

const localeLabels: Record<string, string> = {
  en: 'EN',
  nl: 'NL',
  de: 'DE',
  fr: 'FR',
  es: 'ES',
};
---

{availableLocales.length > 1 && (
  <div class="locale-switcher flex items-center gap-1">
    {availableLocales.map((locale) => {
      const isActive = locale === currentLocale;
      const href = locale === 'en'
        ? Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/')
        : `/${locale}${Astro.url.pathname.replace(/^\/[a-z]{2}\//, '/')}`;

      return (
        <a
          href={href}
          class:list={[
            'locale-option rounded px-2 py-1 text-sm font-medium transition-colors',
            isActive
              ? 'bg-zinc-100 text-zinc-900 dark:bg-white/10 dark:text-white'
              : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white',
          ]}
          aria-current={isActive ? 'true' : undefined}
        >
          {localeLabels[locale] ?? locale.toUpperCase()}
        </a>
      );
    })}
  </div>
)}
