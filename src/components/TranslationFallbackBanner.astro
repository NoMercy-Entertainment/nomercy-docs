---
interface Props {
  show: boolean;
}

const { show } = Astro.props;
---

{show && (
  <div class="translation-fallback-banner mb-6 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 dark:border-sky-800 dark:bg-sky-950 dark:text-sky-200">
    Translation pending — showing English.{' '}
    <a
      href="https://github.com/NoMercy-Entertainment/nomercy-docs/blob/master/CONTRIBUTING.md"
      class="underline hover:no-underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      Help translate
    </a>
  </div>
)}
