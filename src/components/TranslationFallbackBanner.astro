---
import { t } from '../lib/i18n';

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
---

{show && (
  <div
    role="status"
    aria-live="polite"
    class="translation-fallback-banner mb-6 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-800 dark:border-sky-800 dark:bg-sky-950 dark:text-sky-200"
  >
    {t('stub.translationPending', undefined, locale)}{' '}
    <a
      href="https://github.com/NoMercy-Entertainment/nomercy-docs/blob/master/CONTRIBUTING.md"
      class="underline hover:no-underline"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t('stub.translationContribute', undefined, locale)}
    </a>
  </div>
)}
