---
import { getEntry } from 'astro:content';
import MarkdownLayout from '../layouts/MarkdownLayout.astro';
import * as mdxComponents from '../components/protocol';

const indexDoc = await getEntry('nomercy-api', 'index');
if (!indexDoc) {
  throw new Error('nomercy-api/index.mdx not found');
}

const { Content, headings } = await indexDoc.render();

const data = indexDoc.data as any;
let sections = data.sections;

if (!sections || sections.length === 0) {
  sections = [
    { title: 'Documentation', id: 'documentation' },
    { title: 'Getting Started', id: 'getting-started' },
  ];
}
---

<MarkdownLayout
  title={indexDoc.data.title}
  description={indexDoc.data.description}
  sections={sections}
>
  <Content components={mdxComponents} />
</MarkdownLayout>
