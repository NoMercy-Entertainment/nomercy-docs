---
import RootLayout from '../layouts/RootLayout.astro';
---

<RootLayout title="NoMercy Documentation">
  <div class="space-y-12">
    <!-- Hero Section -->
    <section class="py-12 sm:py-16">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6">
          NoMercy Documentation
        </h1>
        <p class="text-xl text-zinc-600 dark:text-zinc-400 leading-8 mb-8">
          Complete guide to setting up and using NoMercy, a comprehensive entertainment management system.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/apps/getting-started" class="inline-flex items-center justify-center px-8 py-3 rounded-lg font-semibold text-white bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-700 dark:hover:bg-emerald-600 transition-colors">
            Get Started
          </a>
          <a href="/apps/installation" class="inline-flex items-center justify-center px-8 py-3 rounded-lg font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950 hover:bg-emerald-100 dark:hover:bg-emerald-900 transition-colors">
            View Installation Guide
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Sections -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 py-12">
      <!-- Apps Section -->
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-lg blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
        <div class="relative bg-white dark:bg-zinc-900 rounded-lg p-8 border border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">Applications</h2>
            <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 mb-6">
            Learn how to install, configure, and use the NoMercy applications for content discovery and management.
          </p>
          <ul class="space-y-3">
            <li>
              <a href="/apps/getting-started" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                Getting Started
              </a>
            </li>
            <li>
              <a href="/apps/installation" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                Installation Guide
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- MediaServer Section -->
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-lg blur opacity-0 group-hover:opacity-75 transition duration-300"></div>
        <div class="relative bg-white dark:bg-zinc-900 rounded-lg p-8 border border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">MediaServer</h2>
            <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.19 11a6.002 6.002 0 010 11.712M15 13h4m-2 2v-4m-11-2a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 mb-6">
            Set up and manage the MediaServer component for efficient media file storage and organization.
          </p>
          <ul class="space-y-3">
            <li>
              <a href="/mediaserver/overview" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                Overview
              </a>
            </li>
            <li>
              <a href="/mediaserver/configuration" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium">
                Configuration
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="bg-zinc-50 dark:bg-zinc-800/50 rounded-lg p-8 border border-zinc-200 dark:border-zinc-700">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">Quick Links</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/apps/getting-started" class="p-4 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors">
          <h3 class="font-semibold text-zinc-900 dark:text-white">Getting Started</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">Begin your NoMercy journey with basic setup</p>
        </a>
        <a href="/apps/installation" class="p-4 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors">
          <h3 class="font-semibold text-zinc-900 dark:text-white">Installation</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">Step-by-step installation instructions</p>
        </a>
        <a href="/mediaserver/overview" class="p-4 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors">
          <h3 class="font-semibold text-zinc-900 dark:text-white">MediaServer Overview</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">Learn about media management features</p>
        </a>
        <a href="/mediaserver/configuration" class="p-4 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors">
          <h3 class="font-semibold text-zinc-900 dark:text-white">MediaServer Config</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">Configure MediaServer for your needs</p>
        </a>
      </div>
    </section>
  </div>
</RootLayout>
