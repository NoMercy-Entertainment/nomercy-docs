---
import { getCollection } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';

// Import MDX components
import * as mdxComponents from '../../components/protocol';

const docs = await getCollection('app', ({ data }) => {
  return data.draft !== true;
});

const indexDoc = docs.find(doc => doc.slug === 'index');

if (!indexDoc) {
  return Astro.redirect('/404');
}

const { Content, headings } = await indexDoc.render();

// Use sections from frontmatter if available, otherwise extract from headings
const sections = indexDoc.data.sections || headings
  .filter((h: any) => h.depth === 2)
  .map((h: any) => ({
    id: h.slug,
    title: h.text,
  }));
---

<MarkdownLayout
  title={indexDoc.data.title}
  description={indexDoc.data.description}
  sections={sections}
>
  <Content components={mdxComponents} />
</MarkdownLayout>
