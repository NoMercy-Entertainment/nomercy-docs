---
import RootLayout from '../layouts/RootLayout.astro';
import { SearchComponent } from '../components/SearchComponent.jsx';
---

<RootLayout title="Search Documentation">
  <div class="max-w-4xl">
    <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-white mb-8">
      Search Documentation
    </h1>
    <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8">
      Search through all our documentation to find exactly what you're looking for.
    </p>
    <SearchComponent client:load />
  </div>
</RootLayout>
