---
import { getCollection } from 'astro:content';
import MarkdownLayout from '../layouts/MarkdownLayout.astro';

import * as mdxComponents from '../components/protocol';

export async function getStaticPaths() {
  const docs = await getCollection('nomercy-api', ({ data }) => {
    return data.draft !== true;
  });

  return docs
    .filter(doc => doc.slug.replace(/^[a-z]{2}\//, '') !== 'index')
    .map(doc => ({
      params: { slug: doc.slug.replace(/^[a-z]{2}\//, '') },
      props: { doc },
    }));
}

interface Props {
  doc: any;
}

const { doc } = Astro.props;
const { Content, headings } = await doc.render();

const isMdx = doc.id.endsWith('.mdx');

const sections = doc.data.sections || headings
  .filter((h: any) => h.depth === 2)
  .map((h: any) => ({
    id: h.slug,
    title: h.text,
  }));
---

<MarkdownLayout
  title={doc.data.title}
  description={doc.data.description}
  sections={sections}
>
  {isMdx ? (
    <Content components={mdxComponents} />
  ) : (
    <article class="pt-16 pb-10">
      <div class="prose dark:prose-invert [html_:where(&>*)]:mx-auto [html_:where(&>*)]:max-w-2xl lg:[html_:where(&>*)]:mx-[calc(50%-min(50%,var(--container-lg)))] lg:[html_:where(&>*)]:max-w-3xl">
        <Content components={mdxComponents} />
      </div>
    </article>
  )}
</MarkdownLayout>
