---
import { getEntry, render } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import * as mdxComponents from '../../components/protocol';

const doc = (await getEntry('nomercy-api', 'en/index.mdx'))
  ?? (await getEntry('nomercy-api', 'en/overview.mdx'));
if (!doc) return Astro.redirect('/');

const { Content, headings } = await render(doc);
const data = doc.data as any;
let sections = data.sections;

if (!sections || sections.length === 0) {
  sections = headings
    .filter((h: any) => h.depth === 2)
    .map((h: any) => ({ id: h.slug, title: h.text }));
}
---

<MarkdownLayout
  title={doc.data.title}
  description={doc.data.description}
  sections={sections}
>
  <Content components={mdxComponents} />
</MarkdownLayout>
