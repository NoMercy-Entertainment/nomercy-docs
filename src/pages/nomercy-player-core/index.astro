---
import { getEntry, render } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import * as mdxComponents from '../../components/protocol';

const indexDoc = await getEntry('nomercy-player-kit', 'en/index.mdx');
if (!indexDoc) {
  return Astro.redirect('/nomercy-player-core/quickstart');
}

const { Content, headings } = await render(indexDoc);
const sections = indexDoc.data.sections || headings
  .filter((h: any) => h.depth === 2)
  .map((h: any) => ({ id: h.slug, title: h.text }));
---

<MarkdownLayout
  title={indexDoc.data.title}
  description={indexDoc.data.description}
  sections={sections}
>
  <Content components={mdxComponents} />
</MarkdownLayout>
