---
import { getCollection, render } from 'astro:content';
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import PageFooterNav from '../../components/PageFooterNav.astro';

import * as mdxComponents from '../../components/protocol';

export async function getStaticPaths() {
  const docs = await getCollection('nomercy-media-server', ({ data }) => {
    return data.draft !== true;
  });

  return docs
    .filter(doc => !/^[a-z]{2}$/.test(doc.id) && doc.id.replace(/^[a-z]{2}\//, '').replace(/\.(md|mdx)$/, '') !== 'index')
    .map(doc => ({
      params: { slug: doc.id.replace(/^[a-z]{2}\//, '').replace(/\.(md|mdx)$/, '') },
      props: { doc },
    }));
}

interface Props {
  doc: any;
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const isMdx = doc.id.endsWith('.mdx');

const sections = doc.data.sections || headings
  .filter((h: any) => h.depth === 2)
  .map((h: any) => ({
    id: h.slug,
    title: h.text,
  }));
---

<MarkdownLayout
  title={doc.data.title}
  description={doc.data.description}
  sections={sections}
>
  {isMdx ? (
    <>
      <Content components={mdxComponents} />
      <div class="mx-auto w-full max-w-3xl lg:max-w-5xl">
        <PageFooterNav pathname={Astro.url.pathname} />
      </div>
    </>
  ) : (
    <article class="pt-2 pb-10">
      <div class="prose dark:prose-invert [html_:where(&>*)]:mx-auto [html_:where(&>*)]:max-w-3xl lg:[html_:where(&>*)]:mx-[calc(50%-min(50%,var(--container-lg)))] lg:[html_:where(&>*)]:max-w-5xl">
        <Content components={mdxComponents} />
      </div>
      <div class="mx-auto w-full max-w-3xl lg:max-w-5xl">
        <PageFooterNav pathname={Astro.url.pathname} />
      </div>
    </article>
  )}
</MarkdownLayout>
