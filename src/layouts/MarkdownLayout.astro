---
import "../styles/global.css";
import { Providers } from "../components/Providers";
import { Layout } from "../components/Layout";
import { Hero } from "../components/protocol/Hero";
import { CodeHighlighter } from "../components/CodeHighlighter";
import PackageManagerSwitcher from "../components/PackageManagerSwitcher.astro";
import { getNavigation } from "../lib/navigation";

interface Props {
  title: string;
  description?: string;
  sections?: Array<{ id: string; title: string; tag?: string }>;
}

const { title, description, sections = [] } = Astro.props;
const pathname = Astro.url.pathname;

// Fetch navigation from all collections
const { sections: navigation, apiGroups } = await getNavigation();

// Build allSections object with current page sections
// Handle both with and without trailing slash, and empty pathname
const normalizedPathname = pathname || "/";
// Ensure sections are properly serialized
const serializedSections = sections.map((s) => ({
  id: s.id,
  title: s.title,
  ...(s.tag && { tag: s.tag }),
}));

const allSections: Record<
  string,
  Array<{ id: string; title: string; tag?: string }>
> = {
  [normalizedPathname]: serializedSections,
  [normalizedPathname.replace(/\/$/, "") || "/"]: serializedSections,
  "/": serializedSections, // Also include root path for index page
};
---

<!doctype html>
<html lang="en" class="h-full" suppressHydrationWarning>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title ? `${title} - NoMercy Docs` : "NoMercy Documentation"}</title>
    <script is:inline>
      (function () {
        try {
          if (typeof window === "undefined") return;
          const theme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;

          // Apply theme immediately to prevent flash
          if (
            theme === "dark" ||
            (theme === "system" && prefersDark) ||
            (!theme && prefersDark)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {
          // Ignore errors
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-full bg-white antialiased dark:bg-zinc-900"
    suppressHydrationWarning
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-md focus:bg-emerald-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:outline-none"
    >
      Skip to content
    </a>
    <Providers client:load>
      <div class="w-full">
        <Hero client:load />
        <Layout
          allSections={allSections}
          navigation={navigation}
          apiGroups={apiGroups}
          initialPathname={normalizedPathname}
          client:load
        >
          <slot />
        </Layout>
      </div>
      <PackageManagerSwitcher />
      <CodeHighlighter client:load />
    </Providers>
  </body>
</html>
