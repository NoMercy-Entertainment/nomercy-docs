---
import clsx from 'clsx'
import Header from '../components/Header.astro'
import Navigation from '../components/Navigation.jsx'
import Footer from '../components/Footer.astro'

interface Props {
  title?: string
  description?: string
  children?: any
}

const { title, description, children } = Astro.props
---

<!DOCTYPE html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title ? `${title} - NoMercy Docs` : 'NoMercy Documentation'}</title>
  </head>
  <body class="flex min-h-full bg-white antialiased dark:bg-zinc-900">
    <div class="w-full">
      <div class="h-full lg:ml-72 xl:ml-80">
        <header class="contents lg:pointer-events-none lg:fixed lg:inset-0 lg:z-40 lg:flex">
          <div class="contents lg:pointer-events-auto lg:block lg:w-72 lg:overflow-y-auto lg:border-r lg:border-zinc-900/10 lg:px-6 lg:pt-4 lg:pb-8 xl:w-80 lg:dark:border-white/10">
            <div class="hidden lg:flex">
              <a href="/" aria-label="Home" class="flex items-center">
                <div class="h-6 w-6 bg-emerald-500 rounded-full"></div>
              </a>
            </div>
            <Header />
            <Navigation client:load />
          </div>
        </header>

        <div class="relative flex h-full flex-col px-4 pt-14 sm:px-6 lg:px-8">
          <main class="flex-auto">
            <slot />
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  :global(html) {
    @apply scroll-smooth;
  }

  :global(body) {
    @apply antialiased;
  }
</style>
