{
	"name": "nomercy-docs",
	"type": "module",
	"version": "0.0.1",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --host",
		"build": "yarn build:native-reference && yarn check:directives && yarn check:doc-imports && yarn check:symbols && yarn check:examples && yarn check:examples:published && yarn check:api-coverage && yarn check:docs && yarn check:prose && yarn check:density && yarn check:code-blocks && yarn check:reviews && yarn check:tiers && yarn check:nav && yarn check:links && yarn build:search && astro build",
		"preview": "yarn build:search && astro build && astro preview --host",
		"astro": "astro",
		"build:search": "node scripts/build-search-index.js",
		"build:native-reference": "node scripts/build-native-reference.mjs",
		"check:api-coverage": "node scripts/check-api-coverage.mjs",
		"check:examples-kmp": "node scripts/check-examples-kmp.mjs",
		"check:docs": "node scripts/check-docs.mjs",
		"check:prose": "node scripts/check-prose.mjs",
		"check:density": "node scripts/check-density.mjs",
		"check:code-blocks": "node scripts/check-code-blocks.mjs",
		"check:reviews": "node scripts/check-reviews-fresh.mjs",
		"check:tiers": "node scripts/check-tiers.mjs",
		"check:symbols": "node scripts/check-doc-symbols.mjs",
		"check:doc-imports": "node scripts/check-doc-imports.mjs",
		"check:directives": "node --test scripts/remark-directives.test.mjs",
		"check:examples": "tsc -p tsconfig.examples.json && node scripts/check-autoplay.mjs",
		"check:examples:published": "tsc -p tsconfig.examples-published.json",
		"check:links": "node scripts/check-links.js",
		"check:nav": "node scripts/check-nav.js",
		"check:snippets": "node scripts/check-snippet-syntax.mjs",
		"snippets:lock": "node scripts/snippet-ranges-lock.mjs"
	},
	"dependencies": {
		"@algolia/autocomplete-core": "^1.19.2",
		"@astrojs/markdown-remark": "^7.2.4",
		"@astrojs/mdx": "^7.0.7",
		"@astrojs/react": "^6.0.4",
		"@headlessui/react": "^2.2.6",
		"@nomercy-entertainment/nomercy-music-player": "^2.2.1",
		"@nomercy-entertainment/nomercy-player-core": "^2.2.1",
		"@nomercy-entertainment/nomercy-video-player": "^2.2.2",
		"@sindresorhus/slugify": "^2.2.1",
		"@tailwindcss/postcss": "^4.1.15",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"acorn": "^8.15.0",
		"astro": "^7.2.8",
		"clsx": "^2.1.1",
		"flexsearch": "^0.8.205",
		"framer-motion": "^12.23.11",
		"gray-matter": "^4.0.3",
		"hast-util-to-string": "^3.0.1",
		"mdast-util-to-string": "^4.0.0",
		"mdx-annotations": "^0.1.4",
		"next-themes": "^0.4.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-highlight-words": "^0.21.0",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.35.4",
		"shiki": "^3.23.0",
		"tailwindcss": "^4.1.15",
		"unist-util-visit": "^5.0.0",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@types/node": "^26.1.1",
		"@types/react-highlight-words": "^0.20.1",
		"esbuild": "^0.28.1",
		"glob": "^10.3.10",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"picomatch": "^2.3.2",
		"esbuild": "^0.28.1",
		"svgo": "^4.1.0",
		"sharp": "^0.35.4",
		"postcss": "^8.5.18",
		"astro/js-yaml": "^4.3.2",
		"brace-expansion": "^2.1.7",
		"browserslist": "^4.28.7",
		"smol-toml": "^1.7.1",
		"baseline-browser-mapping": "^2.11.0",
		"devalue": "^5.9.2",
		"undici": "^8.10.2",
		"gray-matter/js-yaml": "^3.15.2",
		"@tailwindcss/typography/postcss-selector-parser": "^7.1.6"
	},
	"packageManager": "yarn@4.18.1"
}
