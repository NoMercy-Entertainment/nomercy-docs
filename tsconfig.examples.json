{
  // Typecheck gate for src/examples/ — every example the docs render must
  // compile against the REAL player packages. `paths` maps the three package
  // names to their live monorepo SOURCE (mirroring each package.json exports
  // map, same as the packages' own vitest configs) so the docs are proven
  // against code at HEAD, not against whatever dist was last published. When
  // a mapped source path does not exist (standalone checkout of this repo),
  // tsc falls through to normal node_modules resolution — the installed
  // published packages — so the gate still runs, just against the registry
  // versions. Run via `npm run check:examples`.
  //
  // Core's `./streams/*` exports point at dist/adapters/stream/* — the source
  // tree has no streams/ directory — so that subpath needs its own mapping
  // ahead of the catch-all (video and music DO have src/streams/, their
  // catch-alls cover it).
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@nomercy-entertainment/nomercy-player-core": [
        "../../packages/nomercy-player-core/src/index.ts"
      ],
      "@nomercy-entertainment/nomercy-player-core/streams/*": [
        "../../packages/nomercy-player-core/src/adapters/stream/*"
      ],
      "@nomercy-entertainment/nomercy-player-core/*": ["../../packages/nomercy-player-core/src/*"],
      "@nomercy-entertainment/nomercy-video-player": [
        "../../packages/nomercy-video-player/src/index.ts"
      ],
      "@nomercy-entertainment/nomercy-video-player/*": [
        "../../packages/nomercy-video-player/src/*"
      ],
      "@nomercy-entertainment/nomercy-music-player": [
        "../../packages/nomercy-music-player/src/index.ts"
      ],
      "@nomercy-entertainment/nomercy-music-player/*": ["../../packages/nomercy-music-player/src/*"]
    }
  },
  "include": ["src/examples/**/*"]
}
